# Discord Developer Portal > votre application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Clic droit sur le serveur / le salon > Copier l'identifiant (mode développeur activé)
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Optionnel
TIMEZONE=Europe/Paris
# Tous les jours à 10h00
DAILY_CRON=0 10 * * *
# Le dimanche à 20h00
RECAP_CRON=0 20 * * 0
DB_PATH=./data/anime-du-jour.db
# Tirage parmi les POOL_SIZE animes les plus populaires d'AniList ayant une note > MIN_SCORE
MIN_SCORE=70
POOL_SIZE=1000
